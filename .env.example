# Copy to .env and fill in your own values. Never commit the populated file.
# Field reference: CONFIGURATION.md. The CLI uses Claude Agent SDK.
# Anthropic Messages-compatible base URL and Bearer credential.
FMST_CLAUDE_BASE_URL=
FMST_CLAUDE_AUTH_TOKEN=
# Optional model and concurrency settings:
# FMST_CLAUDE_MODEL=
# FMST_CLAUDE_REASONING_EFFORT=high
# FMST_AGENT_CONCURRENCY_LIMIT=5

# Set the absolute path printed by: python src/scripts/prepare_guestweave.py
FMST_GUESTWEAVE_WORKSPACE=
# Your own licensed IDA installation and initialized user profile.
IDADIR=
IDAUSR=

# Build/start these locally using docker/runner-agent/README.md.
# Optional ordinary build/extraction engine; export it for plain docker commands.
# DOCKER_HOST=unix:///var/run/docker.sock
FMST_RUNTIME_BUILDER_IMAGE=firmenstein/runtime-builder:rust1.98-py312-bookworm
FMST_RUNNER_BACKEND=agent_container
FMST_RUNNER_DOCKER_HOST=
FMST_RUNNER_AGENT_IMAGE=firmenstein/runner-agent:py312-runtime
FMST_RUNNER_RUNTIME_INPUTS=

# Optional local service goal passed through Plan/Generation/Runner.
# FMST_REHOSTING_GOAL=Make the native local management service usable for testing.
