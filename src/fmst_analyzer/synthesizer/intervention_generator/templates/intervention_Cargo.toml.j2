[package]
name    = "{{ crate_name }}"
version = "0.1.0"
edition = "2021"

# Standalone crate; opt out of any ancestor workspace.
[workspace]

[lib]
crate-type = ["cdylib", "rlib"]
name       = "{{ crate_name }}"

[dependencies]
fmst-iib-api = { path = "{{ iib_api_relpath }}" }
log          = "0.4"

[build-dependencies]
serde_json = "1"

[lints.rust]
unsafe_code = "warn"
